# Copy to .env and fill in real values. .env is gitignored - never commit it.
FTS_FED_PASSWORD=changeme
FTS_CLIENT_CERT_PASSWORD=changeme
FTS_WEBSOCKET_KEY=changeme
FTS_SECRET_KEY=changeme
# Bearer token for FTS's REST API (SystemUser.token in FTSDataBase.db) -
# must match the token set on the admin SystemUser row
FTS_API_TOKEN=changeme
# Public hostname of the API site in deploy/Caddyfile (the api.* block)
FTS_API_HOST=api.example.duckdns.org
