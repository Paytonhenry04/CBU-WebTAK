[Unit]
Description=CBU WebTAK - FreeTAKServer, CoT feeder and web map
Documentation=https://github.com/Paytonhenry04/CBU-WebTAK
# The individual services declare PartOf= this target, which is what makes
# "systemctl stop cbu-tak.target" stop all of them (Wants=/WantedBy= alone
# only propagates on start, not stop).
Wants=cbu-ftserver.service cbu-adsb-tak.service cbu-weather-tak.service cbu-transit-tak.service cbu-webmap.service
After=cbu-ftserver.service

[Install]
WantedBy=multi-user.target
