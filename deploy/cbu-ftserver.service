[Unit]
Description=FreeTAKServer stack (Docker Compose)
Documentation=https://github.com/Paytonhenry04/CBU-WebTAK
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target
PartOf=cbu-tak.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/payton/TAK/ftserver

# Wrapper rather than a bare 'docker-compose up -d': when compose.yaml has
# changed, compose recreates the containers, and docker-compose v1 crashes
# with KeyError: 'ContainerConfig' doing so, leaving the stack down. The
# script retries after an explicit rm -f, which creates them cleanly.
ExecStart=/home/payton/TAK/deploy/ftserver-up.sh

# 'stop', deliberately not 'down': stopping leaves the containers in place so
# restarting doesn't recreate them (see the bug above). Named volumes hold the
# FTS database and credentials and are untouched either way.
ExecStop=/usr/bin/docker-compose -f compose.yaml stop

TimeoutStartSec=180

[Install]
WantedBy=cbu-tak.target
